body {
    margin-left: 44px;
}

.background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('../assets/clouds.jpg');
  background-size: cover;
}

.app {
    display: grid;
  place-items: center;
  margin-top: 8%;
  margin-left: -18%
}

.calculator {
    width: 460px;
    height: 600px
}

.digit-buttons {
    display: inline;
}

.symbol-buttons {
    display: inline;
}

.buttons-container {
    margin-top: 8%;
    margin-left: 6%;
    margin-bottom: 6%;
    
}

.output-input {
    background-color: white;
    font-size: 20px;
    height: 56px;
    width: 400px;
    margin-top: 5%;
    margin-left: 20px;
}

button {
    font-size: 24px;
    width: 130px;
    height: 60px;
}

.options {
    margin-left: 800px;
    margin-top: -1000px;
    width: 300px;
}
